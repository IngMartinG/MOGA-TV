# Copia este archivo como .env y ajusta los valores.

# development | production
NODE_ENV=development
PORT=3000
# 127.0.0.1 = solo este equipo. 0.0.0.0 = visible en tu red (TV, celular) o en un servidor.
HOST=127.0.0.1
# Dirección pública exacta desde donde se abre la app (se usa para la protección CSRF).
PUBLIC_ORIGIN=http://localhost:3000

# Clave maestra (mínimo 32 caracteres). Cifra credenciales IPTV y enlaces de video.
# Genera una con: npm run secret
# OBLIGATORIA en producción. Si la pierdes o la cambias, habrá que volver a agregar las listas.
APP_SECRET=

# Detrás de un proxy inverso (Nginx, Render, Railway...) pon 1.
TRUST_PROXY=0

ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=7
STREAM_TOKEN_TTL_MINUTES=360
MAX_PLAYLIST_MB=60
MAX_PLAYLISTS_PER_USER=10
UPSTREAM_TIMEOUT_MS=20000
